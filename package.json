{
  "name": "perk-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check:rules": "node scripts/check-rules.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "smoke": "if [ -f .env.local ]; then tsx --env-file=.env.local scripts/smoke.ts; else tsx scripts/smoke.ts; fi"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.72",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.150",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "preserveUnused": true,
    "pre-commit": "npm run check:privacy && node scripts/check-author.mjs",
    "pre-push": "npm run lint && npm run typecheck && npm test && npm run check:rules && node scripts/check-privacy.mjs --all"
  },
  "engines": {
    "node": ">=20.9"
  }
}
