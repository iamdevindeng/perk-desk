# Copy to .env.local and fill in. Never commit .env.local. Server-side only: never prefix these with NEXT_PUBLIC_.

# Required: Qloo hackathon key (sent only as the X-Api-Key header to https://hackathon.api.qloo.com)
QLOO_API_KEY=

# Required for agent mode; if empty the app runs in deterministic fallback mode
DEEPSEEK_API_KEY=

# Optional: Upstash Redis for shared cache + rate limits; if empty an in-memory store is used
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Optional overrides (defaults in src/lib/config.ts)
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# DEEPSEEK_MODEL=deepseek-flash
# PD_AGENT_DISABLED=1   # force fallback mode (no DeepSeek calls)
